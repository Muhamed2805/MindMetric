NODE_ENV=production

# Public origin the browser uses. Use https://your.domain in a real host.
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Alphanumeric password. Special characters break the Compose DATABASE_URL.
POSTGRES_USER=mindmetric
POSTGRES_PASSWORD=replace-with-a-long-password
POSTGRES_DB=mindmetric
