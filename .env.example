NODE_ENV=development

WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
API_PORT=3001

NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

DATABASE_URL=postgres://mindmetric:mindmetric@localhost:5432/mindmetric
# Fallback only. PGlite cannot be shared by Next and Nest.
# DATABASE_URL=pglite:.data/mindmetric
# API_DATABASE_URL=pglite:.data/mindmetric-api

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
